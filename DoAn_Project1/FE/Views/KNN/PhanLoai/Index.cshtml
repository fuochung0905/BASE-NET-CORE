@{
    ViewBag.Title = "Phân loại sinh viên";
    var gioi = ViewBag.Gioi as List<MODELS.K_MEAN.Dtos.UserTasks>;
    var kha = ViewBag.Kha as List<MODELS.K_MEAN.Dtos.UserTasks>;
    var tb = ViewBag.TrungBinh as List<MODELS.K_MEAN.Dtos.UserTasks>;
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Phân Loại Sinh Viên</h2>

    <div class="row text-center">
        <div class="col-md-4">
            <div class="card shadow rounded-4 border-success">
                <div class="card-header bg-success text-white fw-bold">Giỏi</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var s in gioi)
                        {
                            <li class="list-group-item">@s.Name</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow rounded-4 border-primary">
                <div class="card-header bg-primary text-white fw-bold">Khá</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var s in kha)
                        {
                            <li class="list-group-item">@s.Name</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow rounded-4 border-warning">
                <div class="card-header bg-warning text-dark fw-bold">Trung Bình</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var s in tb)
                        {
                            <li class="list-group-item">@s.Name</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>