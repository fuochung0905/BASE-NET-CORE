@{
    var allStudents = new List<MODELS.KNN.Dtos.GroupStudent>();
    allStudents.AddRange(ViewBag.Gioi as List<MODELS.KNN.Dtos.GroupStudent>);
    allStudents.AddRange(ViewBag.Kha as List<MODELS.KNN.Dtos.GroupStudent>);
    allStudents.AddRange(ViewBag.TrungBinh as List<MODELS.KNN.Dtos.GroupStudent>);
    allStudents.AddRange(ViewBag.Yeu as List<MODELS.KNN.Dtos.GroupStudent>);
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="text-center mb-4">📋 Danh sách nhóm sinh viên</h2>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var group in allStudents.GroupBy(s => s.GroupNumber).OrderBy(g => g.Key))
        {
            <div class="col">
                <div class="card shadow h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Nhóm @group.Key</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            @foreach (var student in group)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @student.Name
                                    <span class="badge bg-secondary">@student.Label</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
